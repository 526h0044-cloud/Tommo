{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile and configuration record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique Firebase Auth UID" },
        "email": { "type": "string", "format": "email", "description": "User email address" },
        "displayName": { "type": "string", "description": "User display name" },
        "photoURL": { "type": "string", "description": "Avatar photo URL" },
        "role": { "type": "string", "enum": ["user", "pro", "admin"], "description": "Account role" },
        "plan": { "type": "string", "description": "Account subscription plan" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Account creation timestamp" },
        "lastLoginAt": { "type": "string", "format": "date-time", "description": "Last sign in timestamp" },
        "totalFluffSaved": { "type": "number", "description": "Total fluff tokens saved" },
        "tommoApiKey": { "type": "string", "description": "User active Tommo API key" }
      },
      "required": ["id", "email"]
    },
    "ChatSession": {
      "title": "ChatSession",
      "description": "A conversation session for a user",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique session ID" },
        "userId": { "type": "string", "description": "Owner user UID" },
        "title": { "type": "string", "description": "Session topic or initial prompt snippet" },
        "domain": { "type": "string", "description": "Domain mode of the session" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Last update timestamp" }
      },
      "required": ["id", "userId", "title"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "A single prompt or response message in a chat session",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique message ID" },
        "sessionId": { "type": "string", "description": "Parent chat session ID" },
        "userId": { "type": "string", "description": "Owner user UID" },
        "role": { "type": "string", "enum": ["user", "tommo"], "description": "Message sender role" },
        "content": { "type": "string", "description": "Message body text" },
        "timestamp": { "type": "string", "description": "Display timestamp" },
        "domain": { "type": "string", "description": "Domain mode" }
      },
      "required": ["id", "sessionId", "userId", "role", "content"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile document accessible only by the owner"
    },
    "/users/{userId}/sessions/{sessionId}": {
      "schema": "ChatSession",
      "description": "User chat sessions"
    },
    "/users/{userId}/sessions/{sessionId}/messages/{messageId}": {
      "schema": "ChatMessage",
      "description": "User chat messages within a session"
    }
  }
}
